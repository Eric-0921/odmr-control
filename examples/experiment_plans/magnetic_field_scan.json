      },
      {
        "name": "Bz = 100000 nT - ODMR 扫频（球坐标）",
        "magnetic_field": {
          "magnitude_nT": 100000.0,
          "theta_deg": 0.0,
          "phi_deg": 0.0
        },
        "microwave": {
          "power_dbm": -10,
          "sweep": {
            "start_hz": 2700000000,
            "stop_hz": 3040000000,
            "step_hz": 1000000,
            "dwell_ms": 50,
            "shape": "SAWTOOTH",
