            "step_hz": 1000000,
            "dwell_ms": 50,
            "shape": "SAWTOOTH",
            "retrace": true,
            "trigger": "IMM",
            "execute": true
          }
        },
        "timing": {
          "settle_s": 2.0,
          "hold_s": 20.0,
          "trigger": "immediate"
        },
        "acquisition": {
          "start_trigger": "magnetic_settled",
          "stop_trigger": "hold_elapsed"
        }
      },
      {
        "name": "Bz = 50000 nT - ODMR 扫频",
        "magnetic_field": {
          "x_nT": 0.0,
          "y_nT": 0.0,
          "z_nT": 50000.0
        },
        "microwave": {
          "power_dbm": -10,
          "sweep": {
            "start_hz": 2780000000,
            "stop_hz": 2960000000,
            "step_hz": 1000000,
            "dwell_ms": 50,
            "shape": "SAWTOOTH",
            "retrace": true,
            "trigger": "IMM",
            "execute": true
          }
        },
        "timing": {
          "settle_s": 2.0,
          "hold_s": 20.0,
          "trigger": "immediate"
